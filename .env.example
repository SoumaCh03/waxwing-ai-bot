# Required
TELEGRAM_BOT_TOKEN=YourTelegramBotToken
GEMINI_API_KEY=GeminiApiKey
# Optional but required for the location-based tools
OPENWEATHER_API_KEY=OpenWeatherApiKey
GOOGLE_MAPS_API_KEY=GoogleMapsApiKey

# Optional Firestore configuration
ENABLE_FIRESTORE=false
FIRESTORE_COLLECTION=users
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json

# Optional runtime configuration
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
REQUEST_TIMEOUT_SECONDS=30
PORT=8080
LOG_LEVEL=INFO

